# In dev, requests to /api are proxied to the backend by vite.config.js, so
# this can stay unset locally. In a production build, the frontend and
# backend are typically on different origins/ports (or behind a reverse
# proxy on different paths) -- set this to the backend's real, publicly
# reachable API URL before running `npm run build`, e.g.:
#   VITE_API_BASE=https://pos.example.com/api
VITE_API_BASE=https://your-domain.example.com/api
